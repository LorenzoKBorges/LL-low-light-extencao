{
  "manifest_version": 3,
  "name": "LL, Low Light",
  "version": "1.0",
  "description": "Bloqueia sites durante o hor\u00e1rio definido pelo professor da turma.",
  "key": "",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "oauth2": {
    "client_id": "465874621790-6keqv9ne0drmtfejs0kdvjqb6p54dhvd.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}